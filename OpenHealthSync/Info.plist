<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Loopback</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.healthcare-fitness</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- The app connects to a private, self-hosted server whose address the
             user configures (Tailscale MagicDNS or LAN hostnames over HTTP). -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <!-- Calendar events written by the app link back here. -->
            <key>CFBundleURLName</key>
            <string>dev.ardenlab.loopback</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>loopbacktraining</string>
            </array>
        </dict>
    </array>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>When you switch on "Show in iOS Calendar", Loopback adds your planned runs and strength sessions to its own calendar and keeps them up to date.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Loopback connects to your self-hosted training server on your local network to sync workouts, health metrics and training plans.</string>
</dict>
</plist>
